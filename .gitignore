# live-build working directories
/.build/
/binary/
/cache/
/chroot/
/local/
/.downloads/

# Generated output (ISOs, build logs, checksums, VM test images, and
# anything else landing in here - this directory is 100% build artifacts)
/output/

# Generated metadata
/binary.contents
/binary.packages
/chroot.headers
/chroot.packages.*
/branding-inspection.txt
/guest-*-diagnostics.log

# Build state
/*.exit
/.final-iso
/.autologin-final-iso
/.last-installer-branding-backup
/.offline-build-state/

# Backups
/backups/
*.bak
*.bak.*

# Build locks
/.build.lock
/.lock
