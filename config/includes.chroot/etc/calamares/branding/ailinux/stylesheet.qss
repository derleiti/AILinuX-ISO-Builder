/*
 * AILinuX Calamares branding.
 *
 * Keep this stylesheet deliberately narrow. The partition module uses
 * custom-painted C++ delegates for its device tree, partition bar and choice
 * widgets. Generic QWidget / item-view rules override their palette and can
 * produce dark-on-dark or light-on-light text. The native Breeze palette is
 * therefore authoritative for all module content.
 */

/* Calamares' stable application-shell object names only. */
#sidebarApp {
    background-color: #131822;
    color: #a9b3c0;
    border-right: 1px solid #263040;
}

#logoApp {
    background-color: #131822;
}

/*
 * Sidebar row colors are supplied by branding.desc. Do not add selectors for
 * QWidget, QLabel, QAbstractItemView, QListView, QTreeView, QTableView or
 * ::item here: those selectors also affect the partitioning module.
 */
