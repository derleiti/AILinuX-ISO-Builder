/* AILinuX Nova Dark — aligned with ailinux.me */
QWidget {
    color: #e3e8f1;
    font-family: "Inter", "Noto Sans", sans-serif;
    font-size: 10.5pt;
}
QMainWindow, QDialog, QWidget#centralWidget, QWidget#mainWidget {
    background-color: #0e1116;
}
QLabel {
    background: transparent;
    color: #e3e8f1;
}
QLabel:disabled {
    color: #64748b;
}
#sidebarApp {
    background-color: #131822;
    color: #a9b3c0;
    border-right: 1px solid #263040;
}
#sidebarApp QLabel {
    color: #a9b3c0;
}
QFrame {
    border-color: #263040;
}
QGroupBox {
    background-color: #131822;
    border: 1px solid #263040;
    border-radius: 12px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #7bd7ff;
}
QPushButton {
    background-color: #1b2330;
    color: #e3e8f1;
    border: 1px solid #2f3a4e;
    border-radius: 8px;
    min-height: 34px;
    padding: 4px 16px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #243146;
    border-color: #3aa0ff;
}
QPushButton:pressed, QPushButton:checked {
    background-color: #2f7df4;
    border-color: #7bd7ff;
    color: #ffffff;
}
QPushButton:default {
    background-color: #3aa0ff;
    border-color: #60b4ff;
    color: #0e1116;
}
QPushButton:default:hover {
    background-color: #44d19a;
    border-color: #7bdcb5;
}
QPushButton:disabled {
    background-color: #161b22;
    border-color: #242933;
    color: #64748b;
}
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox,
QComboBox, QListView, QTreeView, QTableView {
    background-color: #131822;
    color: #e3e8f1;
    border: 1px solid #2a3441;
    border-radius: 7px;
    selection-background-color: #2f7df4;
    selection-color: #ffffff;
    padding: 5px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #3aa0ff;
}
QComboBox::drop-down {
    border: 0;
    width: 26px;
}
QComboBox QAbstractItemView {
    background-color: #1b2330;
    border: 1px solid #3aa0ff;
    outline: 0;
}
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e3e8f1;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3aa0ff;
    border: 2px solid #7bd7ff;
}
QProgressBar {
    background-color: #131822;
    color: #e3e8f1;
    border: 1px solid #263040;
    border-radius: 7px;
    text-align: center;
    min-height: 18px;
}
QProgressBar::chunk {
    background-color: #3aa0ff;
    border-radius: 6px;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: #0e1116;
    border: none;
    width: 12px;
    height: 12px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #334155;
    border-radius: 6px;
    min-height: 28px;
    min-width: 28px;
}
QScrollBar::handle:hover {
    background: #3aa0ff;
}
QToolTip {
    background-color: #1b2330;
    color: #e3e8f1;
    border: 1px solid #3aa0ff;
    padding: 6px;
}
