/*
 * AILinuX Calamares dark branding.
 *
 * Contrast policy:
 * - module content is rendered on an opaque near-black surface, never directly
 *   on the branded wallpaper;
 * - primary text is near-white and secondary/disabled text stays deliberately
 *   bright enough for a dark background;
 * - item views are intentionally left to the native Breeze palette because
 *   Calamares' partition module uses custom-painted delegates.
 */

#sidebarApp {
    background-color: #131822;
    color: #cbd5e1;
    border-right: 1px solid #334155;
}

#logoApp {
    background-color: #131822;
}

/* Make installer pages independent of wallpaper/image brightness. */
#mainApp {
    background-color: #0e1116;
    color: #f8fafc;
}

#mainApp QLabel,
#mainApp QCheckBox,
#mainApp QRadioButton,
#mainApp QGroupBox {
    background-color: transparent;
    color: #f8fafc;
}

#mainApp QLabel:disabled,
#mainApp QCheckBox:disabled,
#mainApp QRadioButton:disabled {
    color: #aeb9c8;
}

/*
 * Calamares' partition module contains custom QWidget subclasses which may
 * paint with the desktop palette instead of inheriting #mainApp's background.
 * Scope the dark surface to those concrete widgets only. Do not apply a broad
 * QWidget/QAbstractItemView rule: PartitionBarsView and PartitionLabelsView
 * are custom-painted views whose delegates must keep their native behavior.
 */
#mainApp ChoicePage,
#mainApp PartitionPage,
#mainApp BootInfoWidget,
#mainApp DeviceInfoWidget,
#mainApp EncryptWidget,
#mainApp PartitionSplitterWidget {
    background-color: #0e1116;
    color: #f8fafc;
}

#mainApp ChoicePage QLabel,
#mainApp PartitionPage QLabel,
#mainApp BootInfoWidget QLabel,
#mainApp DeviceInfoWidget QLabel,
#mainApp EncryptWidget QLabel,
#mainApp PartitionSplitterWidget QLabel {
    background-color: transparent;
    color: #f8fafc;
}

#mainApp ChoicePage QLabel:disabled,
#mainApp PartitionPage QLabel:disabled,
#mainApp BootInfoWidget QLabel:disabled,
#mainApp DeviceInfoWidget QLabel:disabled,
#mainApp EncryptWidget QLabel:disabled,
#mainApp PartitionSplitterWidget QLabel:disabled {
    color: #aeb9c8;
}

/* Standard form controls only; do not style QAbstractItemView/QTreeView/etc. */
#mainApp QLineEdit,
#mainApp QTextEdit,
#mainApp QPlainTextEdit,
#mainApp QSpinBox,
#mainApp QDoubleSpinBox,
#mainApp QComboBox {
    background-color: #171e29;
    color: #f8fafc;
    border: 1px solid #64748b;
    border-radius: 5px;
    padding: 5px 7px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

#mainApp QLineEdit:focus,
#mainApp QTextEdit:focus,
#mainApp QPlainTextEdit:focus,
#mainApp QSpinBox:focus,
#mainApp QDoubleSpinBox:focus,
#mainApp QComboBox:focus {
    border-color: #60a5fa;
}

/*
 * QComboBox popups are separate item views. Without an explicit palette Qt can
 * combine our white combo text with Breeze's light popup background, making
 * unselected rows effectively invisible (for example the timezone selector).
 * Scope this narrowly to combo popups so partition/file views keep their native
 * delegate styling.
 */
#mainApp QComboBox QAbstractItemView {
    background-color: #171e29;
    color: #f8fafc;
    border: 1px solid #64748b;
    outline: 0;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

#mainApp QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 3px 7px;
}

#mainApp QComboBox QAbstractItemView::item:hover {
    background-color: #263449;
    color: #ffffff;
}

#mainApp QComboBox QAbstractItemView::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

#mainApp QPushButton {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #64748b;
    border-radius: 6px;
    padding: 6px 12px;
}

#mainApp QPushButton:hover {
    background-color: #263449;
    border-color: #7dd3fc;
}

#mainApp QPushButton:pressed {
    background-color: #172033;
}

#mainApp QPushButton:disabled {
    background-color: #202733;
    color: #aeb9c8;
    border-color: #475569;
}

QToolTip {
    background-color: #111827;
    color: #ffffff;
    border: 1px solid #64748b;
    padding: 4px;
}

/*
 * branding.desc supplies selected/current sidebar-row colors. Keep unscoped
 * QWidget, QAbstractItemView, QListView, QTreeView, QTableView and ::item
 * selectors out of this file to preserve Calamares partition delegates.
 */
