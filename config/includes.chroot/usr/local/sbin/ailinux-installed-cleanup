#!/bin/sh
set -eu

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

installed_user=${1:-}

# Calamares normally assigns defaultGroups while creating the account. Repeat
# the critical administrator-group assignment at the end of installation so a
# packaging/default mismatch cannot leave the freshly-created user powerless.
# Ubuntu already authorizes %sudo. Calamares assigns that group, and this
# finalizer also writes a validated drop-in so the freshly-created account is
# visibly and explicitly authorized even if a desktop/group default changes.
case "$installed_user" in
    ''|root|*[!a-zA-Z0-9_.-]*)
        echo "Invalid installed user supplied by Calamares: $installed_user" >&2
        exit 1
        ;;
esac

if ! id "$installed_user" >/dev/null 2>&1; then
    echo "Calamares user does not exist in target system: $installed_user" >&2
    exit 1
fi

usermod -aG sudo "$installed_user"

if ! id -nG "$installed_user" | tr ' ' '\n' | grep -Fxq sudo; then
    echo "Failed to add $installed_user to the sudo group." >&2
    exit 1
fi

if ! grep -Eq '^[[:space:]]*%sudo[[:space:]]+ALL=' /etc/sudoers; then
    echo "The sudo group is not authorized in /etc/sudoers." >&2
    exit 1
fi

visudo -cf /etc/sudoers

sudoers_file=/etc/sudoers.d/90-ailinux-installer-user
sudoers_tmp=$(mktemp)
cleanup_sudoers_tmp() {
    rm -f "$sudoers_tmp"
}
trap cleanup_sudoers_tmp EXIT HUP INT TERM
printf '%s ALL=(ALL:ALL) ALL\n' "$installed_user" > "$sudoers_tmp"
chmod 0440 "$sudoers_tmp"
visudo -cf "$sudoers_tmp"
install -o root -g root -m 0440 "$sudoers_tmp" "$sudoers_file"
visudo -cf /etc/sudoers
cleanup_sudoers_tmp
trap - EXIT HUP INT TERM

# The installer launcher and distribution-provided web links belong only to
# the live session. Users created by Calamares have already received /etc/skel
# when this target-side job runs, so clean both the skeleton and home folders.
rm -f \
    /etc/skel/Desktop/*.desktop \
    /etc/skel/Schreibtisch/*.desktop \
    /usr/share/applications/ailinux-installer.desktop \
    /usr/share/applications/org.kfocus.web.howtos.desktop \
    /usr/share/applications/org.kubuntu.restore-desktop-links.desktop \
    /usr/share/applications/org.kubuntu.web.home.desktop \
    /usr/local/bin/ailinux-installer

find /home -mindepth 3 -maxdepth 3 -type f \
    \( -path '*/Desktop/*.desktop' -o -path '*/Schreibtisch/*.desktop' \) \
    -delete

# A server-based Plasma image must not start Kubuntu's first-run assistant.
rm -f /usr/share/applications/org.kde.plasma-welcome.desktop

# Das vorangehende packages-Modul entfernt casper, live-boot und live-tools.
# Bis dahin ist /usr/sbin/update-initramfs eine Diversion von live-tools, die
# nichts tut - der initramfs-Schritt des Installers bleibt deshalb wirkungslos
# und das installierte System startet mit dem Live-initramfs weiter. Das sucht
# ein Live-Medium, findet keins und landet in der initramfs-Shell.
update_initramfs=/usr/sbin/update-initramfs
if [ -x /usr/sbin/update-initramfs.orig.initramfs-tools ]; then
    update_initramfs=/usr/sbin/update-initramfs.orig.initramfs-tools
fi

rebuilt=0
for kernel_image in /boot/vmlinuz-*; do
    test -e "$kernel_image" || continue
    version=${kernel_image#/boot/vmlinuz-}
    rm -f "/boot/initrd.img-$version"
    "$update_initramfs" -c -k "$version"
    test -s "/boot/initrd.img-$version" || {
        echo "Initramfs generation failed for $version" >&2
        exit 1
    }
    if lsinitramfs "/boot/initrd.img-$version" 2>/dev/null | grep -q "scripts/casper"; then
        echo "Rebuilt initramfs for $version still contains casper" >&2
        exit 1
    fi
    rebuilt=1
done

test "$rebuilt" -eq 1 || {
    echo "No kernel found for initramfs regeneration." >&2
    exit 1
}

exit 0
