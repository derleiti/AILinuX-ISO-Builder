#!/bin/sh
set -eu

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# GRUB bricht mit "premature end of file /@/boot/vmlinuz-..." ab, wenn
# grub_file_read weniger Bytes liefert, als das Dateisystem als Groesse meldet.
# grub-core/loader/i386/linux.c leitet die Lesemenge aus der Dateigroesse ab
# (prot_file_size = Dateigroesse - Setup-Header) und vergleicht exakt:
#
#     if (grub_file_read (file, prot_mode_mem, len) != len && !grub_errno)
#       grub_error (GRUB_ERR_BAD_OS, N_("premature end of file %s"), argv[0]);
#
# Daraus folgen zwei getrennte Schadensbilder, die hier beide behandelt werden:
#
#   1. Die Datei ist zu kurz. GRUB leitet die Lesemenge aus genau dieser
#      kuerzeren Groesse ab, liest konsistent und meldet nichts - der Kernel
#      startet und scheitert erst spaeter. Geprueft wird gegen das Live-Medium.
#
#   2. Die Datei hat die richtige Groesse, aber ein Loch. Das ist der Fall, der
#      den GRUB-Abbruch tatsaechlich ausloest: btrfs liefert ab dem ersten Loch
#      nichts mehr, waehrend der Inode weiterhin die volle Groesse nennt. ext4
#      gibt fuer Loecher Nullbytes zurueck und faellt deshalb nie auf - eine
#      Test-VM mit ext4-Standardlayout bootet, dieselbe ISO auf btrfs nicht.
#
# Fall 2 entsteht beim Entpacken durch "rsync --sparse" und ist fuer jede
# groessen- oder headerbasierte Pruefung unsichtbar, weil die Groesse stimmt.
# Der Build schaltet --sparse in config/hooks/0145-ailinux-unpackfs-nosparse.chroot
# ab; die Loch-Reparatur weiter unten ist das Sicherheitsnetz, falls ein
# abweichendes Calamares-Modul doch wieder sparse entpackt.
#
# /casper/vmlinuz-<version> auf dem Live-Medium ist dieselbe Datei und wurde
# beim Live-Boot bereits nachweislich vollstaendig gelesen. Sie ist damit die
# verlaessliche Referenz, gegen die hier geprueft und notfalls repariert wird.

root_dir=${1:-}

case "$root_dir" in
    ''|*[!/A-Za-z0-9._-]*)
        echo "Invalid target root supplied by Calamares: $root_dir" >&2
        exit 1
        ;;
esac

test -d "$root_dir/boot" || {
    echo "Target root has no /boot directory: $root_dir" >&2
    exit 1
}

# Liest ein einzelnes Byte als Dezimalwert.
read_byte() {
    od -An -tu1 -j "$2" -N 1 "$1" 2>/dev/null | tr -d ' \n'
}

# Liest 4 Bytes little-endian als Dezimalwert.
read_le32() {
    od -An -tu1 -j "$2" -N 4 "$1" 2>/dev/null |
        awk '{ print $1 + $2 * 256 + $3 * 65536 + $4 * 16777216 }'
}

# Ein bzImage traegt bei 0x1FE die Bootsignatur 0x55AA und bei 0x202 die
# Kennung "HdrS". setup_sects (0x1F1) und syssize (0x1F4, in 16-Byte-Paragraphen)
# beschreiben zusammen, wie viele Bytes GRUB aus der Datei lesen wird:
#
#     (setup_sects + 1) * 512 + syssize * 16
#
# Ist die Datei kleiner als dieser Wert, bricht GRUB exakt mit
# "premature end of file" ab. Signierte Kernel haengen hinten noch eine
# PKCS#7-Signatur an, deshalb wird auf "mindestens" geprueft.
kernel_is_complete() {
    image=$1

    test -f "$image" || return 1

    size=$(stat -c %s "$image" 2>/dev/null) || return 1
    test "$size" -gt 1048576 || return 1

    signature=$(od -An -tx1 -j 510 -N 2 "$image" 2>/dev/null | tr -d ' \n')
    test "$signature" = "55aa" || return 1

    header=$(dd if="$image" bs=1 skip=514 count=4 2>/dev/null)
    test "$header" = "HdrS" || return 1

    setup_sects=$(read_byte "$image" 497)
    syssize=$(read_le32 "$image" 500)

    case "$setup_sects" in ''|*[!0-9]*) return 1 ;; esac
    case "$syssize" in ''|*[!0-9]*) return 1 ;; esac

    test "$setup_sects" -gt 0 || setup_sects=4
    test "$syssize" -gt 0 || return 1

    expected=$(( (setup_sects + 1) * 512 + syssize * 16 ))
    test "$size" -ge "$expected" || return 1

    return 0
}

# Die Loch-Erkennung und -Reparatur steckt in einem eigenen Skript, weil
# ailinux-installed-cleanup sie am Ende der Installation ein zweites Mal
# braucht: dort wird das initramfs neu gebaut, also nach diesem Schritt.
refill_helper=$(dirname "$0")/ailinux-refill-sparse-boot
test -x "$refill_helper" || refill_helper=/usr/local/sbin/ailinux-refill-sparse-boot

repair_sparse_boot_files() {
    test -x "$refill_helper" || {
        echo "Missing $refill_helper; cannot check for holes." >&2
        return 0
    }
    "$refill_helper" "$1"
}

# Casper haengt das Medium normalerweise unter /cdrom ein. Die weiteren Pfade
# decken abweichende Loader und live-boot-Varianten ab, damit die Pruefung auch
# dann greift, wenn nicht von einem klassisch geschriebenen Stick gebootet wird.
find_live_media() {
    if [ -n "${AILINUX_LIVE_MEDIA:-}" ]; then
        if [ -d "$AILINUX_LIVE_MEDIA/casper" ]; then
            printf '%s\n' "$AILINUX_LIVE_MEDIA"
            return 0
        fi
        return 1
    fi

    for candidate in /cdrom /run/live/medium /isodevice /lib/live/mount/medium /media/cdrom; do
        if [ -d "$candidate/casper" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

media_dir=$(find_live_media) || media_dir=

# Vor jeder Groessenpruefung: Loecher erzeugen keine Groessenabweichung und
# wuerden von den folgenden Vergleichen nicht bemerkt.
repair_sparse_boot_files "$root_dir/boot" || exit 1

checked=0
repaired=0

for target_image in "$root_dir"/boot/vmlinuz-*; do
    test -e "$target_image" || continue
    checked=$((checked + 1))

    version=${target_image##*/vmlinuz-}
    source_image="$media_dir/casper/vmlinuz-$version"

    if [ -n "$media_dir" ] && [ -f "$source_image" ]; then
        if ! kernel_is_complete "$source_image"; then
            echo "Live medium carries an incomplete kernel: $source_image" >&2
            exit 1
        fi

        source_size=$(stat -c %s "$source_image")
        target_size=$(stat -c %s "$target_image" 2>/dev/null || echo 0)

        if [ "$source_size" != "$target_size" ]; then
            echo "Kernel $version is truncated in the target ($target_size of $source_size bytes); restoring from the live medium."
            cp --sparse=never -f "$source_image" "$target_image"
            sync
            repaired=$((repaired + 1))
        fi
    fi

    if ! kernel_is_complete "$target_image"; then
        echo "Kernel image is incomplete and cannot be repaired: $target_image" >&2
        echo "The installed system would fail with 'premature end of file' in GRUB." >&2
        exit 1
    fi
done

test "$checked" -gt 0 || {
    echo "No kernel image found below $root_dir/boot." >&2
    exit 1
}

# Der abgeschnittene Kernel ist nur der auffaelligste Schaden: unpackfs kopiert
# den gesamten Dateibaum ueber denselben Lesepfad. Erwischt der Ausfall
# stattdessen den Modulbaum, laedt GRUB den Kernel anstandslos und das System
# bleibt erst beim Root-Dateisystem stehen - dieselbe Ursache, ein spaeteres und
# deutlich schwerer zuzuordnendes Symptom.
#
# Das Metadaten-Listing des squashfs nennt die Soll-Groesse jeder Datei und
# braucht fuer beide Baeume unter 0,1 s. Geprueft werden bewusst nur /boot und
# /usr/lib/modules: beide sind nie eigene Mounts, waehrend /home, /var/log und
# /var/cache bei btrfs als Subvolumes haengen und einen Vergleich ueber den
# ganzen Baum mit Fehlalarmen fluten wuerden.
verify_boot_critical_tree() {
    image="$media_dir/casper/filesystem.squashfs"

    test -f "$image" || return 0
    command -v unsquashfs >/dev/null 2>&1 || return 0

    expected=$(mktemp) || return 0
    actual=$(mktemp) || { rm -f "$expected"; return 0; }
    report=$(mktemp) || { rm -f "$expected" "$actual"; return 0; }

    if ! unsquashfs -ll "$image" boot usr/lib/modules > "$expected.raw" 2>/dev/null; then
        rm -f "$expected" "$expected.raw" "$actual" "$report"
        return 0
    fi

    # Zeilenformat: "-rw-r--r-- root/root  16916992 2026-07-27 05:21 squashfs-root/pfad".
    # Nur regulaere Dateien ("-") tragen eine vergleichbare Groesse. Der Pfad wird
    # ab Feld 6 wieder zusammengesetzt, damit Leerzeichen nicht stoeren.
    awk '
        $1 ~ /^-/ {
            path = $6
            for (i = 7; i <= NF; i++) path = path " " $i
            sub(/^squashfs-root\/?/, "", path)
            if (path != "") printf "%s\t%s\n", $3, path
        }
    ' "$expected.raw" > "$expected"
    rm -f "$expected.raw"

    : > "$actual"
    for tree in boot usr/lib/modules; do
        test -d "$root_dir/$tree" || continue
        ( cd "$root_dir" && find "$tree" -type f -printf '%s\t%p\n' ) >> "$actual" 2>/dev/null || true
    done

    awk -F '\t' '
        NR == FNR { have[$2] = $1; next }
        {
            if (!($2 in have)) {
                printf "Unpacked file is missing: %s\n", $2
                broken++
            } else if (have[$2] + 0 < $1 + 0) {
                printf "Unpacked file is truncated: %s (%d of %d bytes)\n", $2, have[$2], $1
                broken++
            }
        }
        END { if (broken > 0) printf "BROKEN\t%d\n", broken }
    ' "$actual" "$expected" > "$report"

    # Bei flaechigem Schaden waeren es tausende Zeilen; die ersten reichen, um das
    # Muster zu erkennen, die Gesamtzahl steht darunter.
    grep -v '^BROKEN' "$report" | head -20 >&2 || true
    broken=$(awk -F '\t' '$1 == "BROKEN" { print $2 }' "$report")

    rm -f "$expected" "$actual" "$report"

    if [ -n "$broken" ]; then
        echo "$broken boot-critical file(s) did not survive unpacking." >&2
        echo "Installing from this medium would produce a system that cannot boot." >&2
        return 1
    fi

    return 0
}

if [ -n "$media_dir" ]; then
    verify_boot_critical_tree || exit 1
fi

echo "Verified $checked kernel image(s) in the target system;"
echo "restored $repaired from the live medium."
exit 0
