#!/bin/sh
# AILinuX: Infinity-Wallpaper und Infinity-SDDM als Defaults verdrahten.
# Laeuft nach chroot_includes, sodass die temporaer bereitgestellte Infinity-
# Sammlung bereits unter /usr/share liegt.
set -e

WPNAME="Infinity-World-Wallpaper"
IMG="/usr/share/wallpapers/${WPNAME}/contents/images/1920x1080.png"
LNF="/usr/share/plasma/look-and-feel/Infinity-Global-6"
SDDM_THEME="/usr/share/sddm/themes/Infinity-SDDM-6"

echo "I: [ailinux-wallpaper] start"

if [ ! -f "$IMG" ]; then
    echo "E: [ailinux-wallpaper] $IMG fehlt - Abbruch"
    exit 1
fi

# --- 1. Plasma-6-Global-Theme und Wallpaper pruefen ---------------------------
DEFAULTS="$LNF/contents/defaults"
[ -f "$DEFAULTS" ] || {
    echo "E: [ailinux-wallpaper] Infinity-Global-6 fehlt - Abbruch"
    exit 1
}
grep -Fxq "Image=${WPNAME}" "$DEFAULTS" || {
    echo "E: [ailinux-wallpaper] falsches Infinity-Wallpaper in $DEFAULTS"
    exit 1
}
grep -Fxq 'Theme=Infinity-Plasma-Splash-6' "$DEFAULTS" || {
    echo "E: [ailinux-wallpaper] falscher Plasma-6-Splash in $DEFAULTS"
    exit 1
}
echo "I: [ailinux-wallpaper] Plasma-Default: $WPNAME"

# --- 2. SDDM: Infinity-Plasma-6-Theme aktivieren ------------------------------
[ -f "$SDDM_THEME/Main.qml" ] || {
    echo "E: [ailinux-wallpaper] Infinity-SDDM-6 fehlt - Abbruch"
    exit 1
}
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-ailinux-theme.conf <<EOF
[Theme]
Current=Infinity-SDDM-6
EOF
echo "I: [ailinux-wallpaper] SDDM-Theme: Infinity-SDDM-6"

echo "I: [ailinux-wallpaper] fertig"
