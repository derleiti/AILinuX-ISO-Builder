#!/bin/sh
set -eu

chmod 0755 /usr/local/bin/ailinux-installer
chmod 0755 /etc/skel/Desktop/ailinux-installer.desktop
chmod 0755 /usr/local/sbin/ailinux-live-autologin
chmod 0755 /usr/local/sbin/ailinux-installed-cleanup

# sudo refuses all drop-ins when this directory or its files are not owned by root.
# Rootless live-build can otherwise preserve the invoking host user ownership.
chown root:root /etc/sudoers.d
find /etc/sudoers.d -maxdepth 1 -type f -exec chown root:root {} +
chmod 0755 /etc/sudoers.d
find /etc/sudoers.d -maxdepth 1 -type f -exec chmod 0440 {} +

# Kubuntu settings used to seed these links and its welcome assistant. Keep the
# installer icon in the live session, but do not ship Kubuntu web shortcuts.
rm -f \
    /etc/skel/Desktop/org.kfocus.web.howtos.desktop \
    /etc/skel/Desktop/org.kubuntu.web.home.desktop \
    /etc/xdg/autostart/org.kde.plasma-welcome.desktop

if command -v update-alternatives >/dev/null 2>&1; then
    update-alternatives --set x-session-manager /usr/bin/startplasma-wayland 2>/dev/null || true
fi

# KDE System Information resolves LOGO=ailinux-logo through the freedesktop
# icon theme. Refresh hicolor after the AILinuX raster sizes are installed.
if command -v update-icon-caches >/dev/null 2>&1; then
    update-icon-caches /usr/share/icons/hicolor
elif command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache --force --ignore-theme-index /usr/share/icons/hicolor
fi

systemctl enable NetworkManager.service

# Some dependency paths (notably transitional desktop packages) can install
# GDM before this hook runs. AILinux is a KDE Neon image: make SDDM the
# deterministic display manager instead of failing on an existing alias.
if systemctl list-unit-files gdm3.service >/dev/null 2>&1; then
    systemctl disable gdm3.service 2>/dev/null || true
fi
rm -f /etc/systemd/system/display-manager.service
systemctl enable sddm.service
if [ -x /usr/bin/sddm ]; then
    printf '%s\n' /usr/bin/sddm > /etc/X11/default-display-manager
fi

systemctl enable ssh.service
systemctl enable ailinux-graphical-ready.service

rm -f /etc/machine-id
touch /etc/machine-id
