#!/bin/sh
set -eu
export DEBIAN_FRONTEND=noninteractive
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Google Chrome's package creates redundant upstream APT entries, which can
# stall apt on HTTP/1.1 even though the signed AILinux Chrome mirror is healthy.
# Preserve Chrome itself, and always prefer the versioned AILinux mirror.
disable_direct_chrome_sources() {
    if ! grep -Fq 'https://repo.ailinux.me/mirror/dl.google.com/linux/chrome/deb' \
        /etc/apt/sources.list.d/ailinux-mirror.list; then
        echo 'Chrome AILinux mirror missing; refusing to remove upstream sources' >&2
        return 1
    fi
    # Avoid Chrome's own cron/postinst re-enabling the upstream source.
    install -d -m 0755 /etc/default
    if [ -f /etc/default/google-chrome ]; then
        sed -i \
            -e 's/^repo_add_once=.*/repo_add_once="false"/' \
            -e 's/^repo_reenable_on_distupgrade=.*/repo_reenable_on_distupgrade="false"/' \
            /etc/default/google-chrome
    else
        printf '%s\n' 'repo_add_once="false"' 'repo_reenable_on_distupgrade="false"' \
            > /etc/default/google-chrome
    fi
    for source in \
        /etc/apt/sources.list.d/google-chrome.list \
        /etc/apt/sources.list.d/google-chrome.sources \
        /etc/apt/sources.list.d/google-chrome-stable.list \
        /etc/apt/sources.list.d/google-chrome-stable.sources; do
        if [ -f "$source" ] && \
            grep -Eq 'https?://dl\.google\.com/linux/chrome(-stable)?/deb' "$source"; then
            rm -f -- "$source"
            echo "AILinux: suppressed redundant direct Chrome repository: $source"
        fi
    done
    chmod 0644 /etc/apt/sources.list.d/ailinux-mirror.list /etc/default/google-chrome
}
disable_direct_chrome_sources

echo "AILinux final package refresh: apt-get update"
apt-get update

# Fail the ISO build if the Steam/Proton multiarch prerequisites are missing.
for pkg in libc6:i386 libegl1:i386 libgbm1:i386 libgl1:i386 \
    libgl1-mesa-dri:i386 libdrm2:i386 mesa-vulkan-drivers:i386; do
    candidate=$(apt-cache policy "$pkg" | awk '/Candidate:|Installationskandidat:/ {print $2; exit}')
    if [ -z "$candidate" ] || [ "$candidate" = "(none)" ] || [ "$candidate" = "(keine)" ]; then
        echo "Steam multiarch dependency unavailable: $pkg" >&2
        exit 1
    fi
done

# Multiarch libraries cannot be co-installed at different versions. AILinux
# combines KDE neon's libdrm with Kisak Mesa, so check both architectures.
for pkg in libdrm2 libgbm1 libegl-mesa0 libgl1-mesa-dri \
    libglx-mesa0 mesa-libgallium mesa-vulkan-drivers; do
    amd64_version=$(apt-cache policy "$pkg:amd64" | awk '/Candidate:|Installationskandidat:/ {print $2; exit}')
    i386_version=$(apt-cache policy "$pkg:i386" | awk '/Candidate:|Installationskandidat:/ {print $2; exit}')
    if [ -z "$amd64_version" ] || [ -z "$i386_version" ] || \
       [ "$amd64_version" = "(none)" ] || [ "$i386_version" = "(none)" ] || \
       [ "$amd64_version" = "(keine)" ] || [ "$i386_version" = "(keine)" ] || \
       [ "$amd64_version" != "$i386_version" ]; then
        echo "Steam Multi-Arch version mismatch for $pkg: amd64=$amd64_version i386=$i386_version" >&2
        exit 1
    fi
done

# A successful candidate lookup alone does not guarantee APT's dependency
# solver can install Steam, especially when the desktop uses Kisak Mesa.
resolver_log=$(mktemp)
if ! apt-get -s install steam-libs-i386:i386 mesa-vulkan-drivers:i386 > "$resolver_log" 2>&1; then
    echo "Steam Multi-Arch dependency simulation failed:" >&2
    cat "$resolver_log" >&2
    rm -f "$resolver_log"
    exit 1
fi
if grep -q '^Remv ' "$resolver_log"; then
    echo 'Steam Multi-Arch simulation proposes removing installed packages' >&2
    cat "$resolver_log" >&2
    rm -f "$resolver_log"
    exit 1
fi
rm -f "$resolver_log"

echo "AILinux final package refresh: apt-get full-upgrade"
apt-get -y -o Dpkg::Options::="--force-confold" full-upgrade

# An updated Chrome .deb may recreate an upstream entry during full-upgrade.
disable_direct_chrome_sources

# Verify that the exact package state is converged before the initramfs and
# SquashFS are generated. Any remaining upgrade indicates a moving or broken
# repository snapshot and must fail the image build instead of shipping stale.
remaining=$(apt-get -s full-upgrade 2>/dev/null | awk '/^[0-9]+ upgraded,/{print $1; exit}')
case "${remaining:-0}" in
    0) ;;
    *)
        echo "Final full-upgrade left ${remaining} upgrade(s) pending; refusing to freeze stale ISO." >&2
        exit 1
        ;;
esac

# APT configuration and preferences must be readable by unprivileged clients.
for f in /etc/apt/apt.conf.d/99-ailinux-build-network /etc/apt/preferences.d/firefox-mozilla.pref \
    /etc/apt/sources.list.d/ailinux-mirror.list; do
    if [ -f "$f" ]; then chmod 0644 "$f"; fi
done

apt-get clean
rm -rf /var/lib/apt/lists/partial/*
echo "AILinux final package refresh complete: system is fully upgraded before ISO compression."
