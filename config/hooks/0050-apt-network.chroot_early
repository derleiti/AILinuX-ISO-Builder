#!/bin/sh
set -eu

# Rootless live-build creates the chroot directory with the host umask. If the
# filesystem root ends up 0750, package maintainer scripts which deliberately
# drop privileges (for example SDDM using runuser) cannot even traverse /.
# Make the installed filesystem root world-traversable before packages run.
chmod 0755 /

install -d -m 0755 /etc/apt/apt.conf.d
printf '%s\n' \
    'Acquire::Retries "1";' \
    'Acquire::https::Pipeline-Depth "0";' \
    'Acquire::https::No-Cache "true";' \
    'Acquire::https::Timeout "20";' \
    > /etc/apt/apt.conf.d/99-ailinux-build-network
