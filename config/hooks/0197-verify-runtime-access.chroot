#!/bin/sh
# The project checkout's restrictive umask must not leak into the live root.
# In a rootless build the live-build chroot directory itself is 0750; correct
# that root directory independently of the source includes tree.
set -eu
chmod 0755 /
# The final package refresh may recreate _apt cache directories; reconcile
# once more immediately before the runtime and image permission gate.
/usr/local/sbin/ailinux-apt-source-sanity
check_public_dir() {
    path=$1
    [ -d "$path" ] || { echo "AILinux runtime access gate: missing $path" >&2; exit 1; }
    mode=$(stat -c %a "$path")
    other=${mode#${mode%?}}
    case "$other" in
        5|7) ;;
        *) echo "AILinux runtime access gate: inaccessible $path (mode $mode)" >&2; exit 1 ;;
    esac
}
for path in / /usr /usr/bin /usr/lib /usr/lib/systemd /usr/share \
    /usr/share/plasma /usr/share/sddm /usr/share/applications \
    /etc /etc/pam.d /etc/xdg /etc/ssh \
    /var /var/lib /var/lib/apt /var/lib/apt/lists \
    /var/cache /var/cache/apt /var/cache/apt/archives; do
    check_public_dir "$path"
done
for path in /usr/bin/dbus-daemon /usr/bin/bash /usr/lib/systemd/systemd-logind; do
    mode=$(stat -c %a "$path")
    other=${mode#${mode%?}}
    case "$other" in
        5|7) ;;
        *) echo "AILinux runtime access gate: cannot execute $path (mode $mode)" >&2; exit 1 ;;
    esac
done
for path in /etc/os-release /usr/share/applications/ailinux-installer.desktop; do
    mode=$(stat -c %a "$path")
    other=${mode#${mode%?}}
    case "$other" in
        4|5|6|7) ;;
        *) echo "AILinux runtime access gate: cannot read $path (mode $mode)" >&2; exit 1 ;;
    esac
done
for path in /var/lib/apt/lists/partial /var/cache/apt/archives/partial; do
    mode=$(stat -c '%a:%U' "$path")
    [ "$mode" = '700:_apt' ] || {
        echo "AILinux runtime access gate: invalid _apt private directory $path ($mode)" >&2
        exit 1
    }
done
if grep -Eq '^[[:space:]]*deb(-src)?[[:space:]]+.*https?://repo[.]ailinux[.]me/mirror/(archive[.]ubuntu[.]com|security[.]ubuntu[.]com)/ubuntu[[:space:]]' /etc/apt/sources.list; then
    echo 'AILinux runtime access gate: duplicate Ubuntu mirror sources in /etc/apt/sources.list' >&2
    exit 1
fi
echo 'AILinux runtime access gate: public paths, canonical APT sources and _apt directories verified.'
